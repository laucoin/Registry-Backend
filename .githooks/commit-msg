#!/bin/sh
# Validates the commit message against Conventional Commits (semantic-release depends on it).
# Rewrites it from the branch name when possible, tags "wip" commits with [skip ci].

FILE="$1"
MSG=$(head -n 1 "$FILE")
KEYWORDS='build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test|BREAKING_CHANGE'
REGEX="^($KEYWORDS)(\([A-Za-z0-9_ -]+\))?!?[[:space:]]?:[[:space:]].+"

is_valid() { printf '%s' "$1" | grep -Eiq "$REGEX"; }

# Merge, revert and fixup commits generated by git itself are let through
case "$MSG" in
    "Merge "*|'Revert "'*|"fixup! "*|"squash! "*|"[skip ci]"*) exit 0 ;;
esac
is_valid "$MSG" && exit 0

if printf '%s' "$MSG" | grep -Eiq '^wip'; then
    printf '[skip ci] %s\n' "$MSG" > "$FILE"
    echo "WIP commit: \"[skip ci]\" prefix added"
    exit 0
fi

# Try "feat/example" -> "feat(example): message"
BRANCH=$(git branch --show-current)
KEYWORD=$(printf '%s' "$BRANCH" | grep -Eio "($KEYWORDS)" | head -n 1)
DETAIL=${BRANCH##*/}
if [ -n "$KEYWORD" ]; then
    for CANDIDATE in "$KEYWORD($DETAIL): $MSG" "$KEYWORD: $MSG"; do
        if is_valid "$CANDIDATE"; then
            printf '%s\n' "$CANDIDATE" > "$FILE"
            echo "Commit message rewritten from branch \"$BRANCH\": $CANDIDATE"
            exit 0
        fi
    done
fi

cat >&2 <<MSG_END

✖ Commit message "$MSG" does not follow Conventional Commits.

  Expected: <type>(<scope>): <summary>   e.g. feat(auth): add refresh token
  Types:    $(printf '%s' "$KEYWORDS" | sed 's/|/, /g')
  Or start with "wip" to skip CI.

MSG_END
exit 1
