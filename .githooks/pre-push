#!/bin/sh
# Demande une confirmation avant d'effectuer un push vers une branche protégée, d'effectuer un push forcé ou de supprimer une branche distante.
# Git envoie des lignes au format « <référence locale> <SHA local> <référence distante> <SHA distant> » via l'entrée standard.

PROTECTED='refs/heads/main refs/heads/master refs/heads/develop'
ZERO=0000000000000000000000000000000000000000

confirm() {
    [ -r /dev/tty ] || { echo "$1 (no terminal, aborting)" >&2; exit 1; }
    printf '%s (y/N): ' "$1" > /dev/tty
    read -r ANSWER < /dev/tty
    case "$ANSWER" in y|Y|yes|YES) ;; *) echo "Aborting the push." >&2; exit 1 ;; esac
}

while read -r _ LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    if [ "$LOCAL_SHA" = "$ZERO" ]; then
        confirm "Deleting the remote branch \"${REMOTE_REF#refs/heads/}\". Are you sure?"
        continue
    fi
    for BRANCH in $PROTECTED; do
        [ "$REMOTE_REF" = "$BRANCH" ] && confirm "Pushing on \"${BRANCH#refs/heads/}\". Are you sure?"
    done
    # Non fast-forward = le commit distant n'est pas un ancêtre de ce que nous poussons
    if [ "$REMOTE_SHA" != "$ZERO" ] && ! git merge-base --is-ancestor "$REMOTE_SHA" "$LOCAL_SHA" 2>/dev/null; then
        confirm "Force push detected on \"${REMOTE_REF#refs/heads/}\". Are you sure?"
    fi
done
exit 0
