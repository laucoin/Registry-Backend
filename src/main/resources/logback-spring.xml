<configuration>
    <conversionRule conversionWord="customLoggerLevel" converterClass="com.laucoin.registry.core.config.LoggerConfig"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%cyan(%-20thread)] %customLoggerLevel(%-5level) - %msg%n
            </pattern>
        </encoder>
    </appender>

    <root level="info">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
