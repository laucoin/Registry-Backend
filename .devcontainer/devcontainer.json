{
  "name": "registry-backend-dev",
  "dockerComposeFile": "compose.yml",
  "service": "registry-backend",
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "username": "vscode"
    }
  },
  "containerEnv": {
    "GRADLE_USER_HOME": "/home/vscode/.gradle",
    "SPRING_PROFILES_ACTIVE": "dev",
    "JAVA_TOOL_OPTIONS": "-XX:+UseZGC -XX:MaxRAMPercentage=75.0"
  },
  "forwardPorts": [
    8081,
    5005,
    5432,
    8080
  ],
  "portsAttributes": {
    "8081": {
      "label": "Spring App (8081)"
    },
    "5005": {
      "label": "Java Debug"
    },
    "5432": {
      "label": "Postgres"
    },
    "8080": {
      "label": "Keycloak"
    }
  },
  "mounts": [
    "source=gradle-cache,target=/home/vscode/.gradle,type=volume"
  ],
  "onCreateCommand": "git config --global --add safe.directory /workspace",
  "postCreateCommand": "/bin/bash .devcontainer/scripts/bootstrap.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "fwcd.kotlin",
        "richardwillis.vscode-gradle",
        "mhutchie.git-graph",
        "redhat.vscode-yaml",
        "editorconfig.editorconfig",
        "github.vscode-pull-request-github",
        "eamodio.gitlens"
      ],
      "settings": {
        "java.configuration.runtimes": [
          {
            "name": "JavaSE-25",
            "path": "/opt/java/openjdk",
            "default": true
          }
        ],
        "java.import.gradle.enabled": true,
        "java.import.gradle.wrapper.enabled": true,
        "files.watcherExclude": {
          "**/.gradle/**": true,
          "**/build/**": true
        }
      }
    }
  }
}