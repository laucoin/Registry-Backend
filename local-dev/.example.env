# PostgreSQL
PG_PASS= # FIXME: Définir un mot de passe (utilisé pour tous les utilisateurs de bases)
PG_USER=postgres # Utilisateur global pour toutes les bases (un utilisateur nommé comme la base sera créé pour chacune)
PG_REGISTRY_DB=registry
PG_AUTHENTIK_DB=authentik

# Authentik
AU_SECRET_KEY= # FIXME: Généré avec `openssl rand -base64 60 | tr -d '\n'` '(sans le caractère "%")'
AU_SITE_URL=http://localhost:9000 # Hors installation locale, doit être l'URL où Authentik est hébergé. Utilisée pour les URLs de callback et les liens d'e-mail.
AU_EMAIL= # FIXME: Renseigner votre e-mail
AU_PASS= # FIXME: Définir un mot de passe

# Authentik
IDP_PRIVATE_CLIENT_ID=registry # Client confidentiel avec lequel le backend réalise l'échange du code
IDP_PRIVATE_CLIENT_SECRET= # FIXME: Généré avec `openssl rand -hex 32`
IDP_ALLOWED_REDIRECT_URIS=http://localhost:4200/auth/callback # URIs de redirection exactes acceptées par le backend, séparées par des virgules (URLs de callback du frontend)
IDP_ALLOWED_LOGOUT_REDIRECT_URIS=http://localhost:4200 # URIs exactes, séparées par des virgules, vers lesquelles l'utilisateur peut être renvoyé après déconnexion (origines du frontend)
IDP_PUBLIC_CLIENT_ID=registry-swagger # Client public sous lequel Swagger UI s'authentifie (authorization code + PKCE)
