# PostgreSQL
PG_PASS= # FIXME: Define a password (used for all databases users)
PG_USER=postgres # Global user for all databases (one user will be created for each database with the database name)
PG_REGISTRY_DB=registry
PG_AUTHENTIK_DB=authentik

# Authentik
AU_SECRET_KEY= # FIXME: Generated using `openssl rand -base64 60 | tr -d '\n'` '(Without the "%" char)'
AU_SITE_URL=http://localhost:9000 # If not for local setup, this should be the URL where Authentik is hosted. It is used for callback URLs and email links.
AU_EMAIL= # FIXME: Set your email (Authentik bootstrap admin)
AU_PASS= # FIXME: Define a password (Authentik bootstrap admin)
AU_DEV_PASSWORD= # FIXME: Shared password for the seeded dev users (administrator@sgdf.fr, ...) provisioned by authentik/blueprints/registry.yaml

# OIDC (Registry application in Authentik — consumed by the blueprint AND the backend `local` profile)
IDP_PRIVATE_CLIENT_ID=registry # Must match the application/provider slug provisioned by the blueprint
IDP_PRIVATE_CLIENT_SECRET= # FIXME: Define the confidential client secret (shared by Authentik provider and the backend)
IDP_PUBLIC_CLIENT_ID=registry # Public client id used by Swagger UI (same app in local)
