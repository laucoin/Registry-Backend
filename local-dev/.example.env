# PostgreSQL
PG_PASS= # FIXME: Define a password (used for all databases users)
PG_USER=postgres # Global user for all databases (one user will be created for each database with the database name)
PG_REGISTRY_DB=registry
PG_AUTHENTIK_DB=authentik

# Authentik
AU_SECRET_KEY= # FIXME: Generated using `openssl rand -base64 60 | tr -d '\n'` '(Without the "%" char)'
AU_SITE_URL=http://localhost:9000 # If not for local setup, this should be the URL where Authentik is hosted. It is used for callback URLs and email links.
AU_EMAIL= # FIXME: Set your email
AU_PASS= # FIXME: Define a password

# Identity provider clients — consumed by the Authentik blueprint in authentik/blueprints/
# and by the backend's own configuration. The blueprint provisions both clients on startup.
IDP_PRIVATE_CLIENT_ID=registry # Confidential client the backend brokers the code exchange with
IDP_PRIVATE_CLIENT_SECRET= # FIXME: Generated using `openssl rand -hex 32`
IDP_PUBLIC_CLIENT_ID=registry-swagger # Public client Swagger UI authenticates as. Must differ from the
                                      # confidential one above: Swagger holds no secret, and a confidential
                                      # client with none is refused at the token endpoint
AU_DEV_PASSWORD= # FIXME: Password for the seeded non-admin `registry-dev` account
