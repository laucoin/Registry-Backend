# PostgreSQL
PG_PASS= # FIXME: Define a password (used for all databases users)
PG_USER=postgres # Global user for all databases (one user will be created for each database with the database name)
PG_REGISTRY_DB=registry
PG_AUTHENTIK_DB=authentik

# Authentik
AU_SECRET_KEY= # FIXME: Generated using `openssl rand -base64 60 | tr -d '\n'` '(Without the "%" char)'
AU_SITE_URL=http://localhost:9000 # If not for local setup, this should be the URL where Authentik is hosted. It is used for callback URLs and email links.
AU_EMAIL= # FIXME: Set your email
AU_PASS= # FIXME: Define a password
AU_DEV_PASSWORD= # FIXME: Define a shared password for the seeded dev users (administrator@sgdf.fr, ...)

# OIDC (Registry application in Authentik — consumed by the blueprint AND the backend `local` profile)
OIDC_PRIVATE_CLIENT_ID=registry
OIDC_PRIVATE_CLIENT_SECRET= # FIXME: Set your the local dev client secret you want
OIDC_PRIVATE_REDIRECT_URI=http://localhost:4200/auth/callback # Angular dev server + the frontend's /auth/callback route
OIDC_PUBLIC_CLIENT_ID=registry-swagger
OIDC_PUBLIC_REDIRECT_URI=http://localhost:8082/actuator/swagger-ui/oauth2-redirect.html # Swagger UI, served on the management port
